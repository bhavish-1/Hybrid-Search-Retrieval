# SEC requires a descriptive User-Agent identifying the requester.
JANUS_SEC_USER_AGENT="Your Name your.email@example.com"

JANUS_DB_HOST=localhost
JANUS_DB_PORT=55432
JANUS_DB_NAME=janus
JANUS_DB_USER=janus
JANUS_DB_PASSWORD=janus

# Read-only role used ONLY by the generated-SQL executor.
JANUS_RO_DB_USER=janus_ro
JANUS_RO_DB_PASSWORD=janus_ro

# LLM provider: ollama | anthropic | openai
JANUS_LLM_PROVIDER=ollama
JANUS_OLLAMA_HOST=http://localhost:11434
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
